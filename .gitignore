# ── PLUTUS_VISION ignores: each rule names the FACT that justifies it ──────────────────────
# git worktrees of THIS SAME repository checking out other branches (proven by `git worktree
# list`: MIMO_AGENT -> mimo_agent, DEEPSEEK_AGENT -> deepseek_agent). Committing them would
# embed another branch's tree inside step_agent.
MIMO_AGENT/
DEEPSEEK_AGENT/

# an archive of a directory that is already tracked in full (pine-ide.zip = 1509 files of pine-ide/)
pine-ide.zip

# scratch and staging, not source
.scratch-probe/
.handover-stage/

# vendored third-party inside a packaged copy
Ship_Packages/**/novnc/vendor/

# regenerable / runtime
node_modules/
__pycache__/
*.pyc
*.db-shm
*.db-wal
.DS_Store

# archives of directories already tracked uncompressed; the 196 MB one also exceeds GitHub's
# 100 MB per-file limit, so tracking it would make the repository unpushable
handovers/PLUTUS_VISION_CONTEXT_HANDOVER.zip
Original_Canon_Data/Handover_Data.zip

# agent/runtime state, logs and stale archives - regenerable, not source
.archive/
.fence/
.ua/
runtime/
station.log
.omp/graph-intelligence/
forensic/pv-session-code/.ua/
forensic/pv-session-window/.omp/
forensic/pv-session-window/.ua/

# an archive of a directory already tracked uncompressed
Original_Canon_Data/Toolset.zip

# ── BUILD OUTPUT: extracted knowledge cards, and the built ship package ────────────────────
# Each card is ONE facet EXTRACTED from a tracked bible - its own frontmatter names the source
# ("source: 'PLUTUS_ARCHITECTURE_BIBLE_4.0.md:1116'"), and scripts/build_card.py is the generator.
# 1,395 cards derived from bibles that ARE tracked: regeneration is lossless, so the derived
# output is not versioned. (The same artifact class the pre-commit hook exempts as
# "machine-generated ... produced by tools, not authored": .trident/*, forensic/pv-session-*.)
cards/
vcards/
MASTER_CONTEXT/mechanisms/
MASTER_CONTEXT/laws/
MASTER_CONTEXT/rulings/
MASTER_CONTEXT/hard-limits/
MASTER_CONTEXT/terms/
MASTER_CONTEXT/state/
MASTER_CONTEXT/gates/
MASTER_CONTEXT/sources/

# a BUILT, DISTRIBUTABLE package of this tree (its own PACKAGE_AUDIT.md + SHIP_DOCS_MANIFEST.md),
# regenerated by the ship-package flow - not a second source of truth
Ship_Packages/plutus-vision/
