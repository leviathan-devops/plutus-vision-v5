//@version=6
indicator("Plutus Vision", overlay=true, max_boxes_count=200, max_lines_count=100, max_labels_count=200)

// Monday 07:00 UTC lock. Prior Friday freeze only. No bar of the drawn week is read.

var float friH = na
var float friL = na
var float friC = na
var float accH = na
var float accL = na
var float accC = na
var int lastMon = na

var float[] swP = array.new_float()
var int[] swT = array.new_int()

// ── the path tracer state (fix 2026-10-18: real bar times, touch order) ──
var float[]  wkKept  = array.new_float()   // this week's ladder
var string[] wkName  = array.new_string()  // its names, same index
var int[]    wkTch   = array.new_int()     // 0 = untouched, 1 = touched
var float[]  pathV   = array.new_float()   // vertex prices   (all in kept)
var int[]    pathT   = array.new_int()     // vertex TIMES    (real bar times)
var string[] pathN   = array.new_string()  // vertex labels
// the COMPLETED week's path — snapshotted when the next Monday lock arrives,
// because the lock clears pathV for the new week and barstate.islast would
// then render an empty path (session fix 2026-10-18).
var float[]  prevV   = array.new_float()
var int[]    prevT   = array.new_int()
var string[] prevN   = array.new_string()

bool isMon7 = dayofweek == dayofweek.monday and hour == 7 and minute == 0
bool eNew = isMon7 and (na(lastMon) or time != lastMon)

// Accumulate the week that is ending. Freeze it on the Monday open.
if eNew
    if not na(accH)
        friH := accH
        friL := accL
        friC := accC
    accH := high
    accL := low
    accC := close
    lastMon := time
else
    accH := na(accH) ? high : math.max(accH, high)
    accL := na(accL) ? low : math.min(accL, low)
    accC := close

// Confirmed swings only. A swing is confirmed 2 bars after it prints.
// Only swings before the current Monday are usable.
if bar_index >= 4
    bool sh = high[2] > high[3] and high[2] > high[4] and high[2] > high[1] and high[2] > high
    bool sl = low[2] < low[3] and low[2] < low[4] and low[2] < low[1] and low[2] < low
    if sh
        array.push(swP, high[2])
        array.push(swT, time[2])
    if sl
        array.push(swP, low[2])
        array.push(swT, time[2])
    if array.size(swP) > 40
        array.shift(swP)
        array.shift(swT)

// Draw only on the Monday lock, and only when a prior week exists.
if eNew and not na(friH)
    float pH = friH
    float pL = friL
    float pC = friC
    float rng = math.max(pH - pL, 0.05)
    float spot = pC
    float eEq = (pH + pL) / 2.0

    // kept: prior high, prior low, eq, .00/.50 inside the range, nearest swings within 1.2
    float[] lv = array.new_float()
    array.push(lv, pH)
    array.push(lv, pL)
    array.push(lv, eEq)
    float rx = math.ceil((pL + 0.01) / 0.5) * 0.5
    int g = 0
    while rx < pH - 0.01 and g < 8
        if math.abs(rx - eEq) > 0.12 and math.abs(rx - pH) > 0.12 and math.abs(rx - pL) > 0.12
            array.push(lv, rx)
        rx += 0.5
        g += 1
    float nearHi = na
    float nearLo = na
    if array.size(swP) > 0
        for i = 0 to array.size(swP) - 1
            if array.get(swT, i) < time
                float sp = array.get(swP, i)
                if math.abs(sp - spot) <= 1.2
                    if sp > spot and (na(nearHi) or sp < nearHi)
                        nearHi := sp
                    if sp < spot and (na(nearLo) or sp > nearLo)
                        nearLo := sp
    if not na(nearHi)
        array.push(lv, nearHi)
    if not na(nearLo)
        array.push(lv, nearLo)

    // sort + collapse within 0.12
    int n = array.size(lv)
    if n > 1
        for a = 0 to n - 2
            for b = a + 1 to n - 1
                if array.get(lv, b) < array.get(lv, a)
                    float tp = array.get(lv, a)
                    array.set(lv, a, array.get(lv, b))
                    array.set(lv, b, tp)
    float[] kept = array.new_float()
    if n > 0
        array.push(kept, array.get(lv, 0))
        for i = 1 to n - 1
            if array.get(lv, i) - array.get(kept, array.size(kept) - 1) > 0.12
                array.push(kept, array.get(lv, i))

    int nR = array.size(kept)
    if nR < 2
        // should not happen; prior high/low always present
        array.push(kept, pL)
        array.push(kept, eEq)
        array.push(kept, pH)
        nR := array.size(kept)

    // snapshot the week that just COMPLETED, then reset the tracer
    array.clear(prevV), array.clear(prevT), array.clear(prevN)
    if array.size(pathV) >= 2
        for i = 0 to array.size(pathV) - 1
            array.push(prevV, array.get(pathV, i))
            array.push(prevT, array.get(pathT, i))
            array.push(prevN, array.get(pathN, i))
    array.clear(wkKept), array.clear(wkName), array.clear(wkTch)
    array.clear(pathV),  array.clear(pathT),  array.clear(pathN)
    for i = 0 to nR - 1
        float lv0 = array.get(kept, i)
        string nm0 = math.abs(lv0 - pH) < 0.09 ? "PRIOR HIGH" :
                     math.abs(lv0 - pL) < 0.09 ? "PRIOR LOW" :
                     math.abs(lv0 - eEq) < 0.09 ? "EQUILIBRIUM" :
                     math.abs(lv0 - math.round(lv0 * 2.0) / 2.0) < 0.04 ? "ROUND " + str.tostring(lv0, "#.00") :
                     lv0 > spot ? "SWING HIGH" : "SWING LOW"
        array.push(wkKept, lv0), array.push(wkName, nm0), array.push(wkTch, 0)

    // Discrete thin named bands. Height 0.07. Real names only.
    int tL = time
    float bandH = 0.07
    for i = 0 to nR - 1
        float lv_ = array.get(kept, i)
        string nm = "RUNG"
        color bg = color.new(color.rgb(255, 160, 0), 72)
        color bd = color.rgb(255, 170, 20)
        if math.abs(lv_ - pH) < 0.09
            nm := "PRIOR HIGH"
            bg := color.new(color.rgb(200, 60, 35), 72)
            bd := color.rgb(220, 70, 40)
        else if math.abs(lv_ - pL) < 0.09
            nm := "PRIOR LOW"
            bg := color.new(color.rgb(0, 170, 170), 72)
            bd := color.rgb(0, 190, 190)
        else if math.abs(lv_ - eEq) < 0.09
            nm := "EQUILIBRIUM"
        else if math.abs(lv_ - math.round(lv_ * 2.0) / 2.0) < 0.04
            nm := "ROUND " + str.tostring(lv_, "#.00")
        else
            nm := lv_ > spot ? "SWING HIGH" : "SWING LOW"
            if lv_ > spot
                bg := color.new(color.rgb(200, 60, 35), 75)
                bd := color.rgb(220, 70, 40)
            else
                bg := color.new(color.rgb(0, 170, 170), 75)
                bd := color.rgb(0, 190, 190)
        box.new(tL, lv_ + bandH / 2, tL + 5 * 86400000, lv_ - bandH / 2, xloc=xloc.bar_time, bgcolor=bg, border_color=bd, border_width=1)
        label.new(tL, lv_, nm, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(bd, 8), textcolor=color.white, size=size.small)



// ── THE TRACER — runs on every bar. A rung is "touched" when the bar's
//    range spans it. The vertex carries THAT bar's time, so the path is a
//    record of where price went, never a clock offset.
if not na(friH) and array.size(wkKept) > 0
    int nW = array.size(wkKept)
    for i = 0 to nW - 1
        if array.get(wkTch, i) == 0
            float L = array.get(wkKept, i)
            if low <= L and high >= L
                array.set(wkTch, i, 1)
                if array.size(pathV) < 5          // four segments, five vertices
                    array.push(pathV, L)
                    array.push(pathT, time)        // ← REAL bar time
                    string vn = ""
                    int k = array.size(pathV) - 1
                    vn := k == 0 ? "OPEN" : k == 1 ? "SS" : k == 2 ? "BS" : k == 3 ? "R" : "WL"
                    array.push(pathN, vn)

// ── E2 — THE BOX STAIRCASE ──────────────────────────────────────────────
// The reference has NO polyline. It is a chain of axis-aligned boxes whose
// top/bottom edges sit ON two adjacent ladder rungs and whose left/right
// edges are entry-time .. exit-time. Consecutive boxes SHARE an edge.
// (session fix 2026-10-18: was line.new() diagonals — the wrong object)
color eCyan = color.rgb(0, 210, 230)
if barstate.islast
    float[] dV = array.new_float()
    int[]   dT = array.new_int()
    string[] dN = array.new_string()
    if array.size(prevV) >= 2
        for i = 0 to array.size(prevV) - 1
            array.push(dV, array.get(prevV, i))
            array.push(dT, array.get(prevT, i))
            array.push(dN, array.get(prevN, i))
    else if array.size(pathV) >= 2
        for i = 0 to array.size(pathV) - 1
            array.push(dV, array.get(pathV, i))
            array.push(dT, array.get(pathT, i))
            array.push(dN, array.get(pathN, i))
    int nD = array.size(dV)
    if nD >= 2
        for i = 0 to nD - 2
            float a0 = array.get(dV, i)          // entry level
            float a1 = array.get(dV, i + 1)      // exit level
            int   t0 = array.get(dT, i)          // entry time
            int   t1 = array.get(dT, i + 1)      // exit time
            float top = math.max(a0, a1)
            float bot = math.min(a0, a1)
            string stepN = array.get(dN, i + 1)  // the step this box completes
            box.new(t0, top, t1, bot, xloc = xloc.bar_time,
                    bgcolor = color.new(eCyan, 78),
                    border_color = eCyan, border_width = 2)
            if t1 > t0
                label.new(math.round((t0 + t1) / 2), (top + bot) / 2, stepN,
                          xloc = xloc.bar_time, style = label.style_label_center,
                          color = color.new(eCyan, 20), textcolor = color.black,
                          size = size.small)
