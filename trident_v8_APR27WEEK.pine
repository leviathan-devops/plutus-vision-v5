//@version=6
indicator("TRIDENT v8 — 4-Pair Master", overlay=true, max_boxes_count=2000, max_labels_count=2000, max_lines_count=2000)

// ═══════════════════════════════════════════════════════════════════════
// TRIDENT v8 — 4-PAIR MASTER INDICATOR
//
// CHART CONTENTS (per pair):
//   ✅ IP Zones: Resistance=RED, Equilibrium=#FF9800, Support=TEAL
//   ✅ LSZ Zones: GREEN filled boxes, NO LABELS, same width as IP zones
//   ✅ Option Strike Targets: amber lines + labels
//   ❌ 4H S/D Zones: REMOVED (user maps manually)
//   ❌ Trade setups: table only (no chart drawings)
//
// MULTI-PAIR RULES:
//   - Each pair's data maps ONLY to its own chart (no cross-mapping)
//   - Pair detection via syminfo.ticker
//   - Unknown tickers show info table only
//   - DXY zones use DXY price scale
//   - EU/GU/AU zones use their own price scales
//   - NO mathematical conversion between pairs
//
// TABLE: 2×17 per pair, trades = 3 rows each
// COLORS: RED=IP Resistance, #FF9800=Equilibrium, TEAL=IP Support
//         GREEN=LSZ, AMBER=Option Strikes
// ═══════════════════════════════════════════════════════════════════════

string GRP_VIS = "Visibility"

show_zones   = input.bool(true, "IP Zones",        group=GRP_VIS)
show_lsz     = input.bool(true, "LSZ",              group=GRP_VIS)
show_options = input.bool(true, "Option Strikes",    group=GRP_VIS)
show_table   = input.bool(true, "Info Table",        group=GRP_VIS)

// ── ZONE DATE RANGE: 2 weeks back + data week + 3 weeks forward (Apr27-May1 week) ──
int tsL   = timestamp(2026, 4, 13, 0, 0, 0)
int tsR   = timestamp(2026, 5, 22, 23, 59, 59)
int tsMid = (tsL + tsR) / 2

// ═══════════════════════════════════════════════════════════════════════
// COLORS — Pressure Ladder System
// ═══════════════════════════════════════════════════════════════════════

// IP Resistance (RED) — 6 pressure tiers
R_F1 = color.new(color.rgb(180,40,30), 70),  R_B1 = color.rgb(180,40,30)
R_F2 = color.new(color.rgb(200,60,35), 70),  R_B2 = color.rgb(200,60,35)
R_F3 = color.new(color.rgb(210,80,40), 70),  R_B3 = color.rgb(210,80,40)
R_F4 = color.new(color.rgb(220,100,50), 70), R_B4 = color.rgb(220,100,50)
R_F5 = color.new(color.rgb(230,130,60), 70), R_B5 = color.rgb(230,130,60)
R_F6 = color.new(color.rgb(240,160,90), 70), R_B6 = color.rgb(240,160,90)

// IP Equilibrium (ORANGE #FF9800) — 6 pressure tiers
G_F1 = color.new(color.rgb(255,152,0), 70),   G_B1 = color.rgb(255,152,0)
G_F2 = color.new(color.rgb(245,145,10), 70),  G_B2 = color.rgb(245,145,10)
G_F3 = color.new(color.rgb(235,138,20), 70),  G_B3 = color.rgb(235,138,20)
G_F4 = color.new(color.rgb(225,131,30), 70),  G_B4 = color.rgb(225,131,30)
G_F5 = color.new(color.rgb(215,124,40), 70),  G_B5 = color.rgb(215,124,40)
G_F6 = color.new(color.rgb(205,117,50), 70),  G_B6 = color.rgb(205,117,50)

// IP Support (TEAL) — 6 pressure tiers
T_F1 = color.new(color.rgb(0,150,150), 70),  T_B1 = color.rgb(0,150,150)
T_F2 = color.new(color.rgb(0,170,160), 70),  T_B2 = color.rgb(0,170,160)
T_F3 = color.new(color.rgb(20,180,170), 70), T_B3 = color.rgb(20,180,170)
T_F4 = color.new(color.rgb(40,190,180), 70), T_B4 = color.rgb(40,190,180)
T_F5 = color.new(color.rgb(60,200,190), 70), T_B5 = color.rgb(60,200,190)
T_F6 = color.new(color.rgb(80,210,200), 70), T_B6 = color.rgb(80,210,200)

zfill(string cat, string deg) =>
    color result = color.gray
    if cat == "RES"
        if deg == "EXTREME"
            result := R_F1
        else if deg == "HEAVY"
            result := R_F2
        else if deg == "MODERATE-HEAVY"
            result := R_F3
        else if deg == "MODERATE"
            result := R_F4
        else if deg == "LIGHT"
            result := R_F5
        else
            result := R_F6
    else if cat == "MID"
        if deg == "EXTREME"
            result := G_F1
        else if deg == "HEAVY"
            result := G_F2
        else if deg == "MODERATE-HEAVY"
            result := G_F3
        else if deg == "MODERATE"
            result := G_F4
        else if deg == "LIGHT"
            result := G_F5
        else
            result := G_F6
    else if cat == "SUP"
        if deg == "EXTREME"
            result := T_F1
        else if deg == "HEAVY"
            result := T_F2
        else if deg == "MODERATE-HEAVY"
            result := T_F3
        else if deg == "MODERATE"
            result := T_F4
        else if deg == "LIGHT"
            result := T_F5
        else
            result := T_F6
    else
        result := T_F4
    result

zbord(string cat, string deg) =>
    color result = color.gray
    if cat == "RES"
        if deg == "EXTREME"
            result := R_B1
        else if deg == "HEAVY"
            result := R_B2
        else if deg == "MODERATE-HEAVY"
            result := R_B3
        else if deg == "MODERATE"
            result := R_B4
        else if deg == "LIGHT"
            result := R_B5
        else
            result := R_B6
    else if cat == "MID"
        if deg == "EXTREME"
            result := G_B1
        else if deg == "HEAVY"
            result := G_B2
        else if deg == "MODERATE-HEAVY"
            result := G_B3
        else if deg == "MODERATE"
            result := G_B4
        else if deg == "LIGHT"
            result := G_B5
        else
            result := G_B6
    else if cat == "SUP"
        if deg == "EXTREME"
            result := T_B1
        else if deg == "HEAVY"
            result := T_B2
        else if deg == "MODERATE-HEAVY"
            result := T_B3
        else if deg == "MODERATE"
            result := T_B4
        else if deg == "LIGHT"
            result := T_B5
        else
            result := T_B6
    else
        result := T_B4
    result

pressureLbl(string deg) =>
    deg == "EXTREME" ? "Extreme" : deg == "HEAVY" ? "Heavy" : deg == "MODERATE-HEAVY" ? "Moderate-Heavy" : deg == "MODERATE" ? "Moderate" : deg == "LIGHT" ? "Light" : "Minimal"

// LSZ Colors — ALL GREEN, FILLED ZONES
LSZ_STD_F = color.new(color.rgb(40,180,80), 70),  LSZ_STD_B = color.rgb(40,180,80)
LSZ_ACT_F = color.new(color.rgb(80,230,100), 60), LSZ_ACT_B = color.rgb(80,230,100)

// ═══════════════════════════════════════════════════════════════════════
// PAIR DETECTION
// ═══════════════════════════════════════════════════════════════════════

string ticker = str.upper(str.replace(syminfo.ticker, "/", ""))
bool isDXY = ticker == "DXY" or ticker == "DX-Y.NYB" or str.contains(ticker, "DXY")
bool isEU  = ticker == "EURUSD" or ticker == "EURUSD=X" or str.contains(ticker, "EURUSD")
bool isGU  = ticker == "GBPUSD" or ticker == "GBPUSD=X" or str.contains(ticker, "GBPUSD")
bool isAU  = ticker == "AUDUSD" or ticker == "AUDUSD=X" or str.contains(ticker, "AUDUSD")
bool isKnown = isDXY or isEU or isGU or isAU

string pairLabel = isDXY ? "DXY" : isEU ? "EUR/USD" : isGU ? "GBP/USD" : isAU ? "AUD/USD" : "UNKNOWN"

// ── Tables — declared at global scope for Pine v6 compatibility ──
// NOTE (Apr27 variant): tbl is 2x24 — 12 zones need rows 5-16, TRADES header moves
// to row 17, trades to 18-23. The eu/gu/au tables stay 2x17 (5 zones each).
var table tbl    = table.new(position.top_right, 2, 24, bgcolor=color.new(color.black, 10), border_color=color.rgb(40,40,45), border_width=1)
var table tbl_eu = table.new(position.top_right, 2, 17, bgcolor=color.new(color.black, 10), border_color=color.rgb(40,40,45), border_width=1)
var table tbl_gu = table.new(position.top_right, 2, 17, bgcolor=color.new(color.black, 10), border_color=color.rgb(40,40,45), border_width=1)
var table tbl_au = table.new(position.top_right, 2, 17, bgcolor=color.new(color.black, 10), border_color=color.rgb(40,40,45), border_width=1)

// ═══════════════════════════════════════════════════════════════════════
// DATA — DXY (Apr 27-May 1 2026) — TRANSCRIBED from
// Leviathan_DXY_IL_Report_Apr27-May1_2026.pdf, Section 2 zone map (page 5).
// Categories: zones 1-5 RES, 6-8 MID, 9-12 SUP. Degrees: MINIMAL catch-all,
// LIGHT, MODERATE, MODERATE-HEAVY. Tiers: T1 = zones 6 + 11, else T2.
// ═══════════════════════════════════════════════════════════════════════

var array<float>  dxy_zTp   = array.from(100.000, 99.725, 99.500, 99.350, 99.180, 99.022, 98.842, 98.673, 98.500, 98.257, 98.033, 97.630)
var array<float>  dxy_zBt   = array.from(99.893, 99.600, 99.393, 99.220, 99.055, 98.920, 98.721, 98.529, 98.353, 98.131, 97.930, 97.500)
var array<string> dxy_zCat  = array.from("RES", "RES", "RES", "RES", "RES", "MID", "MID", "MID", "SUP", "SUP", "SUP", "SUP")
var array<string> dxy_zDeg  = array.from("MINIMAL", "MINIMAL", "LIGHT", "LIGHT", "LIGHT", "MODERATE-HEAVY", "LIGHT", "MODERATE", "MODERATE", "LIGHT", "MODERATE-HEAVY", "LIGHT")
var array<string> dxy_zTir  = array.from("T2", "T2", "T2", "T2", "T2", "T1", "T2", "T2", "T2", "T2", "T1", "T2")
var array<string> dxy_zNm   = array.from("Upper Resistance", "Resistance", "Resistance", "Resistance", "Resistance", "Upper Equilibrium / Decision Zone", "Equilibrium", "Mid-Range Support / Equilibrium", "Key Support Band", "Support", "Lower Support / Liquidity Sweep", "Deep Support")
// ZONE FAILURE PROBABILITY — report-sourced, NOT derived. Authoritative source:
// Leviathan_DXY_IL_Report_Apr27-May1_2026.pdf: Zone 6 §11 "~25-35% (MODERATE)",
// Zone 11 §11 "~20-30% (MODERATE)"; remaining ZFPs from the pressure-degree band
// (MODERATE-HEAVY ~30, MODERATE ~37, LIGHT ~50, MINIMAL ~70 — midpoints of the
// report's own §11 ZFP band table). A width-derived number is NOT a failure
// probability and must never be printed under the ZFP name.
var array<int>    dxy_zZfp  = array.from(70, 70, 50, 50, 50, 30, 50, 37, 37, 50, 25, 50)

// LSZ: the Apr27 report carries NO LSZ table (no "Liquidity Sweep Zones" section;
// the 4H overlay names BoM Demand [98.01-98.23] + MoM Supply [98.88-99.18] +
// BoM Supply [98.14-98.29] as 4H zones, NOT LSZ rows). The swing anchors the
// report DOES print: Swing High 99.440 (zone 5 driver), Swing Low 97.630 Apr 17
// (zone 12 driver), Prior Wk Low 98.010 LIQ SWEEP (zone 11 driver). These three
// swing levels are the report-sourced LSZ rows: 99.440 ceiling-side STANDARD,
// 98.010 sweep ACTIVE, 97.630 floor ACTIVE. No other LSZ row exists in the report.
var array<float>  dxy_xTp   = array.from(99.440, 98.010, 97.630)
var array<float>  dxy_xBt   = array.from(99.435, 98.005, 97.625)
var array<string> dxy_xPri  = array.from("STANDARD", "ACTIVE", "ACTIVE")

// OPTION STRIKES — the 7 heaviest EUR/USD notionals, DXY-mapped ONLY where the
// report prints a DXY map (zone drivers). 1.1700 4.1bn has NO printed DXY map —
// it is REFUSED as an oPr entry (no invented mapping; D7). DXY maps: 99.229
// (1.1600 Tue 3.5bn), 98.991 (1.1650 Mon-Wed 7.7bn), 98.837 (1.1680 Tue 1.7bn),
// 98.619 (1.1725 Tue-Thu 4.5bn), 98.473 (1.1755 Tue 4.5bn), 98.257 (1.1800 Tue-Thu
// 2.8bn), 98.018 (1.1850 Fri 964m). Kept: the 7 heaviest mapped = 99.229, 98.991,
// 98.837, 98.619, 98.473, 98.257, 98.018.
var array<float>  dxy_oPr   = array.from(99.229, 98.991, 98.837, 98.619, 98.473, 98.257, 98.018)
var array<string> dxy_oVol  = array.from("3.5bn", "7.7bn", "1.7bn", "4.5bn", "4.5bn", "2.8bn", "964m")

// E3 TRADES — §13 Trade Flow Map verbatim (3 trades; the template renders 2:
