// ═══════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════

volLbl(string vol) =>
    string result = "$"
    if str.contains(vol, "bn")
        string num = str.replace(vol, "bn", "")
        float val = str.tonumber(num)
        result := "$" + str.tostring(val, "#.#") + "B"
    else
        result := "$" + vol
    result

// ZFP is NOT derivable from zone geometry. It is the report's Zone Failure
// Probability and is carried in the per-pair zZfp arrays (see DATA sections).
// The former calcZFP() (zone width / reference range * 100) computed a WIDTH
// ratio and printed it under the ZFP name — a fabrication. REMOVED.

// ═══════════════════════════════════════════════════════════════════════
// DRAW ON LAST BAR — Per-Pair Rendering
// Pine v6 requires explicit if/else for array selection
// (ternary chains don't work with array types)
// ═══════════════════════════════════════════════════════════════════════

if barstate.islast and isDXY
    int nZ = array.size(dxy_zTp)
    int nX = array.size(dxy_xTp)
    int nO = array.size(dxy_oPr)
    string pFmt = "#.##"

    // ── IP ZONES ──
    if show_zones
        for i = 0 to nZ - 1
            string c   = array.get(dxy_zCat, i)
            string d   = array.get(dxy_zDeg, i)
            float  tp  = array.get(dxy_zTp, i)
            float  bt  = array.get(dxy_zBt, i)
            string nm  = array.get(dxy_zNm, i)
            box.new(tsL, tp, tsR, bt, bgcolor=zfill(c, d), border_color=zbord(c, d), border_width=2, border_style=line.style_solid, xloc=xloc.bar_time)
            float midY = (tp + bt) / 2.0
            string prs = pressureLbl(d)
            int zfp = array.get(dxy_zZfp, i)
            string lbl = nm + " | " + prs + " | " + (zfp < 0 ? "ZFP n/a" : str.tostring(zfp) + "% ZFP")
            label.new(tsMid, midY, lbl, xloc=xloc.bar_time, style=label.style_none, textcolor=color.white, size=size.normal)

    // ── LSZ ──
    if show_lsz
        for i = 0 to nX - 1
            float  tp    = array.get(dxy_xTp, i)
            float  bt    = array.get(dxy_xBt, i)
            string pri   = array.get(dxy_xPri, i)
            bool   isAct = pri == "ACTIVE"
            color x_bg = isAct ? LSZ_ACT_F : LSZ_STD_F
            color x_bd = isAct ? LSZ_ACT_B : LSZ_STD_B
            int   x_w  = isAct ? 2 : 1
            box.new(tsL, tp, tsR, bt, bgcolor=x_bg, border_color=x_bd, border_width=x_w, border_style=line.style_solid, xloc=xloc.bar_time)

    // ── OPTION STRIKES ──
    if show_options
        for i = 0 to nO - 1
            float  op  = array.get(dxy_oPr, i)
            string vol = array.get(dxy_oVol, i)
            int    ow  = str.contains(vol, "bn") ? 2 : 1
            line.new(tsL, op, tsR, op, xloc=xloc.bar_time, color=color.rgb(255,200,60), width=ow, style=line.style_solid)
            string oLbl = volLbl(vol) + " Option Strike Target"
            label.new(tsMid, op, oLbl, xloc=xloc.bar_time, style=label.style_none, textcolor=color.rgb(255,200,60), size=size.normal)

    // ── TABLE (Apr27 variant: 12 zones → rows 5-16; TRADES header row 17) ──
    if show_table
        table.cell(tbl, 0, 0, "TRIDENT v8 APR27", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl, 1, 0, "DXY Apr27-May1", text_color=color.rgb(100,150,255), text_size=size.small, bgcolor=color.rgb(20,20,40))
        table.cell(tbl, 0, 1, "Chain", text_color=color.gray, text_size=size.small)
        table.cell(tbl, 1, 1, array.get(dxy_sCh,0) + " " + str.tostring(array.get(dxy_sCf,0), "#") + "%", text_color=color.white, text_size=size.small)
        table.cell(tbl, 0, 2, "Alt", text_color=color.gray, text_size=size.small)
        table.cell(tbl, 1, 2, array.get(dxy_sAlt,0) + " " + str.tostring(array.get(dxy_sAc,0), "#") + "%", text_color=color.gray, text_size=size.small)
        table.cell(tbl, 0, 3, "Days", text_color=color.gray, text_size=size.small)
        table.cell(tbl, 1, 3, "M:SS T:SS-BS W:SS-FOMC Th:BS/RWL F:SS/WL", text_color=color.white, text_size=size.small)
        table.cell(tbl, 0, 4, "ZONES", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl, 1, 4, "", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        for i = 0 to nZ - 1
            string c = array.get(dxy_zCat, i)
            string tag = c == "RES" ? "RES" : c == "MID" ? "EQ" : "SUP"
            color bg = c == "RES" ? color.rgb(60,12,8) : c == "MID" ? color.rgb(50,38,8) : color.rgb(0,40,40)
            string pr = str.tostring(array.get(dxy_zTp,i), pFmt) + "-" + str.tostring(array.get(dxy_zBt,i), pFmt)
            string prs = pressureLbl(array.get(dxy_zDeg, i))
            int zfp = array.get(dxy_zZfp, i)
            table.cell(tbl, 0, i+5, tag, text_color=color.white, text_size=size.small, bgcolor=bg)
            table.cell(tbl, 1, i+5, pr + " " + prs + " " + (zfp < 0 ? "ZFP n/a " : str.tostring(zfp) + "%ZFP ") + array.get(dxy_zTir,i), text_color=color.white, text_size=size.small, bgcolor=bg)
        table.cell(tbl, 0, 17, "TRADES", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl, 1, 17, "T3 SHORT 98.92-99.00 SL99.15 TP98.50 3.8x (text row)", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        color sBg = color.rgb(60,12,8)
        table.cell(tbl, 0, 18, "L " + array.get(dxy_tTir,0), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl, 1, 18, "Entry: " + str.tostring(array.get(dxy_tEn1,0), pFmt) + " - " + str.tostring(array.get(dxy_tEn3,0), pFmt), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl, 0, 19, "", text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl, 1, 19, "SL: " + str.tostring(array.get(dxy_tSl,0), pFmt) + "  |  TP: " + str.tostring(array.get(dxy_tTp,0), pFmt), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl, 0, 20, "", text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl, 1, 20, array.get(dxy_tDE,0) + " > " + array.get(dxy_tDT,0) + "  |  R:R " + str.tostring(array.get(dxy_tRr,0), "#.#"), text_color=color.white, text_size=size.small, bgcolor=sBg)
        color lBg = color.rgb(0,40,40)
        table.cell(tbl, 0, 21, "L " + array.get(dxy_tTir,1), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl, 1, 21, "Entry: " + str.tostring(array.get(dxy_tEn1,1), pFmt) + " - " + str.tostring(array.get(dxy_tEn3,1), pFmt), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl, 0, 22, "", text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl, 1, 22, "SL: " + str.tostring(array.get(dxy_tSl,1), pFmt) + "  |  TP: " + str.tostring(array.get(dxy_tTp,1), pFmt), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl, 0, 23, "", text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl, 1, 23, array.get(dxy_tDE,1) + " > " + array.get(dxy_tDT,1) + "  |  R:R " + str.tostring(array.get(dxy_tRr,1), "#.#"), text_color=color.white, text_size=size.small, bgcolor=lBg)

