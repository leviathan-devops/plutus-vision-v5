            string c   = array.get(au_zCat, i)
            string d   = array.get(au_zDeg, i)
            float  tp  = array.get(au_zTp, i)
            float  bt  = array.get(au_zBt, i)
            string nm  = array.get(au_zNm, i)
            box.new(tsL, tp, tsR, bt, bgcolor=zfill(c, d), border_color=zbord(c, d), border_width=2, border_style=line.style_solid, xloc=xloc.bar_time)
            float midY = (tp + bt) / 2.0
            string prs = pressureLbl(d)
            int zfp = array.get(au_zZfp, i)
            string lbl = nm + " | " + prs + " | " + (zfp < 0 ? "ZFP n/a" : str.tostring(zfp) + "% ZFP")
            label.new(tsMid, midY, lbl, xloc=xloc.bar_time, style=label.style_none, textcolor=color.white, size=size.normal)

    if show_lsz
        for i = 0 to nX - 1
            float  tp    = array.get(au_xTp, i)
            float  bt    = array.get(au_xBt, i)
            string pri   = array.get(au_xPri, i)
            bool   isAct = pri == "ACTIVE"
            color x_bg = isAct ? LSZ_ACT_F : LSZ_STD_F
            color x_bd = isAct ? LSZ_ACT_B : LSZ_STD_B
            int   x_w  = isAct ? 2 : 1
            box.new(tsL, tp, tsR, bt, bgcolor=x_bg, border_color=x_bd, border_width=x_w, border_style=line.style_solid, xloc=xloc.bar_time)

    if show_options
        for i = 0 to nO - 1
            float  op  = array.get(au_oPr, i)
            string vol = array.get(au_oVol, i)
            int    ow  = str.contains(vol, "bn") ? 2 : 1
            line.new(tsL, op, tsR, op, xloc=xloc.bar_time, color=color.rgb(255,200,60), width=ow, style=line.style_solid)
            string oLbl = volLbl(vol) + " Option Strike Target"
            label.new(tsMid, op, oLbl, xloc=xloc.bar_time, style=label.style_none, textcolor=color.rgb(255,200,60), size=size.normal)

    if show_table
        table.cell(tbl_au, 0, 0, "TRIDENT v8", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl_au, 1, 0, "AUD/USD Apr20-24", text_color=color.rgb(230,160,60), text_size=size.small, bgcolor=color.rgb(50,30,10))
        table.cell(tbl_au, 0, 1, "Chain", text_color=color.gray, text_size=size.small)
        table.cell(tbl_au, 1, 1, array.get(au_sCh,0) + " " + str.tostring(array.get(au_sCf,0), "#") + "%", text_color=color.white, text_size=size.small)
        table.cell(tbl_au, 0, 2, "Alt", text_color=color.gray, text_size=size.small)
        table.cell(tbl_au, 1, 2, array.get(au_sAlt,0) + " " + str.tostring(array.get(au_sAc,0), "#") + "%", text_color=color.gray, text_size=size.small)
        table.cell(tbl_au, 0, 3, "Days", text_color=color.gray, text_size=size.small)
        table.cell(tbl_au, 1, 3, "M:SS/H T:SS-BS W:BS-R Th:R-SS F:SS-WL", text_color=color.white, text_size=size.small)
        table.cell(tbl_au, 0, 4, "ZONES", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl_au, 1, 4, "", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        for i = 0 to nZ - 1
            string c = array.get(au_zCat, i)
            string tag = c == "RES" ? "RES" : c == "MID" ? "EQ" : "SUP"
            color bg = c == "RES" ? color.rgb(60,12,8) : c == "MID" ? color.rgb(50,38,8) : color.rgb(0,40,40)
            string pr = str.tostring(array.get(au_zTp,i), pFmt) + "-" + str.tostring(array.get(au_zBt,i), pFmt)
            string prs = pressureLbl(array.get(au_zDeg, i))
            int zfp = array.get(au_zZfp, i)
            table.cell(tbl_au, 0, i+5, tag, text_color=color.white, text_size=size.small, bgcolor=bg)
            table.cell(tbl_au, 1, i+5, pr + " " + prs + " " + (zfp < 0 ? "ZFP n/a " : str.tostring(zfp) + "%ZFP ") + array.get(au_zTir,i), text_color=color.white, text_size=size.small, bgcolor=bg)
        table.cell(tbl_au, 0, 10, "TRADES", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl_au, 1, 10, "", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        color sBg = color.rgb(60,12,8)
        table.cell(tbl_au, 0, 11, "S " + array.get(au_tTir,0), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 1, 11, "Entry: " + str.tostring(array.get(au_tEn1,0), pFmt) + " - " + str.tostring(array.get(au_tEn3,0), pFmt), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 0, 12, "", text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 1, 12, "SL: " + str.tostring(array.get(au_tSl,0), pFmt) + "  |  TP: " + str.tostring(array.get(au_tTp,0), pFmt), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 0, 13, "", text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 1, 13, array.get(au_tDE,0) + " > " + array.get(au_tDT,0) + "  |  R:R " + str.tostring(array.get(au_tRr,0), "#.#"), text_color=color.white, text_size=size.small, bgcolor=sBg)
        color lBg = color.rgb(0,40,40)
        table.cell(tbl_au, 0, 14, "L " + array.get(au_tTir,1), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 1, 14, "Entry: " + str.tostring(array.get(au_tEn1,1), pFmt) + " - " + str.tostring(array.get(au_tEn3,1), pFmt), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 0, 15, "", text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 1, 15, "SL: " + str.tostring(array.get(au_tSl,1), pFmt) + "  |  TP: " + str.tostring(array.get(au_tTp,1), pFmt), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 0, 16, "", text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 1, 16, array.get(au_tDE,1) + " > " + array.get(au_tDT,1) + "  |  R:R " + str.tostring(array.get(au_tRr,1), "#.#"), text_color=color.white, text_size=size.small, bgcolor=lBg)
