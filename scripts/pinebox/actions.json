{
  "version": "1.0.0",
  "comment": "THE PINEBOX VERB TABLE (blueprint 7B). The CLI scripts/pinebox/pinebox is the only implementation; the OMP extension and the MCP server read this table to turn a tool call into CLI argv and add nothing. A new verb is one row here plus its function in pinebox.",
  "params": {
    "id": {
      "type": "string",
      "description": "the pinebox instance id 0..9. OPTIONAL: omit it and the verb acts on YOUR session's only pinebox; `up` with no id allocates one for your session. An id owned by another session is refused (SESSION_FOREIGN)."
    },
    "week": {
      "type": "string",
      "description": "the bar fixture week, e.g. 2026-07-06 (fixtures/bars/<week>.json must exist)"
    },
    "pair": {
      "type": "string",
      "description": "the instrument, e.g. DXY"
    },
    "tf": {
      "type": "string",
      "description": "the timeframe, e.g. 1H"
    },
    "pine": {
      "type": "string",
      "description": "a Pine source file to load and run (stage 5)"
    },
    "adapter": {
      "type": "string",
      "description": "force a surface adapter (weston-x11 | weston-vnc | xvfb | existing)"
    },
    "out": {
      "type": "string",
      "description": "a file path for the frame"
    },
    "action": {
      "type": "string",
      "description": "widget: list, open or close"
    },
    "x": {
      "type": "number",
      "description": "drive click: page CSS pixels"
    },
    "y": {
      "type": "number",
      "description": "drive click: page CSS pixels"
    },
    "text": {
      "type": "string",
      "description": "drive type: the text"
    },
    "key": {
      "type": "string",
      "description": "drive key: a CDP chord such as Enter or ctrl+a"
    },
    "send": {
      "type": "string",
      "description": "terminal: text to send to the instance's tmux"
    },
    "read": {
      "type": "boolean",
      "description": "terminal: read the pane"
    },
    "get": {
      "type": "string",
      "description": "state: the key to read"
    },
    "put": {
      "type": "string",
      "description": "state: the key to write"
    },
    "value": {
      "type": "string",
      "description": "state put: the value"
    },
    "project": {
      "type": "number",
      "description": "status: project the measured memory to this many instances"
    },
    "all": {
      "type": "boolean",
      "description": "down: every instance"
    },
    "confirm": {
      "type": "boolean",
      "description": "view: REQUIRED - set only when the operator asked to see the instance; view raises a window on their screen"
    },
    "set": {
      "type": "string",
      "description": "week: the ISO week label to set in the IDE, e.g. 2026-W28"
    },
    "mode": {
      "type": "string",
      "description": "editor: get or set"
    },
    "to": {
      "type": "string",
      "description": "tab: pine or backtest"
    },
    "op": {
      "type": "string",
      "description": "chart: pan, zoom, fit, view, resize"
    },
    "dx": {
      "type": "number",
      "description": "chart pan: horizontal fraction"
    },
    "dy": {
      "type": "number",
      "description": "chart pan: vertical fraction"
    },
    "dir": {
      "type": "string",
      "description": "chart zoom: IN or OUT"
    },
    "size": {
      "type": "string",
      "description": "chart resize: WxH"
    },
    "symbol": {
      "type": "string",
      "description": "asset: DXY, EURUSD or GBPUSD"
    },
    "name": {
      "type": "string",
      "description": "widget: its name"
    },
    "speed": {
      "type": "number",
      "description": "backtest: replay interval in milliseconds per bar"
    },
    "date": {
      "type": "string",
      "description": "backtest: replay start date YYYY-MM-DD"
    },
    "n": {
      "type": "number",
      "description": "backtest: number of replay steps"
    },
    "section": {
      "type": "string",
      "description": "shot/look: capture only a SECTION of the page, located from the page's own layout - chart (the chart workspace: symbol bar, tools, plot, axes) or plot (the plotting area only)"
    },
    "cmd": {
      "type": "string",
      "description": "spawn: the program (and its arguments) to start INSIDE the new instance, e.g. \"zenity --info --text hi\"; checked before anything is claimed (CMD_NOT_FOUND)"
    },
    "judge": {
      "type": "boolean",
      "description": "verify: after the arithmetic verify, also ask the independent image judge about a fresh chart capture and write a content-addressed ticket (needs `clause`); a pass:false ticket is refused as JUDGE_FAILED"
    },
    "clause": {
      "type": "string",
      "description": "verify --judge: the clause id to judge, from judge/clauses.txt (calibrated: C1.1)"
    }
  },
  "actions": {
    "ports": {
      "argv": [
        "ports"
      ],
      "flags": [
        "id"
      ]
    },
    "up": {
      "argv": [
        "up"
      ],
      "flags": [
        "id",
        "week",
        "pair",
        "tf",
        "pine",
        "adapter"
      ]
    },
    "spawn": {
      "argv": [
        "spawn"
      ],
      "flags": [
        "id",
        "cmd",
        "week",
        "pair",
        "tf",
        "pine",
        "adapter"
      ]
    },
    "attach": {
      "argv": [
        "attach"
      ],
      "flags": [
        "id"
      ]
    },
    "down": {
      "argv": [
        "down"
      ],
      "flags": [
        "id",
        "all"
      ]
    },
    "list": {
      "argv": [
        "list"
      ],
      "flags": []
    },
    "status": {
      "argv": [
        "status"
      ],
      "flags": [
        "id",
        "project"
      ]
    },
    "shot": {
      "argv": [
        "shot"
      ],
      "flags": [
        "id",
        "out",
        "section"
      ]
    },
    "load": {
      "argv": [
        "load"
      ],
      "flags": [
        "id",
        "pine",
        "pair",
        "tf"
      ]
    },
    "drive": {
      "argv": [
        "drive"
      ],
      "flags": [
        "id",
        "action",
        "x",
        "y",
        "text",
        "key",
        "out"
      ]
    },
    "terminal": {
      "argv": [
        "terminal"
      ],
      "flags": [
        "id",
        "send",
        "read"
      ]
    },
    "state": {
      "argv": [
        "state"
      ],
      "flags": [
        "id",
        "get",
        "put",
        "value"
      ]
    },
    "view": {
      "argv": [
        "view"
      ],
      "flags": [
        "id",
        "confirm"
      ]
    },
    "week": {
      "argv": [
        "week"
      ],
      "flags": [
        "id",
        "set"
      ]
    },
    "verify": {
      "argv": [
        "verify"
      ],
      "flags": [
        "id",
        "week",
        "judge",
        "clause"
      ]
    },
    "insert": {
      "argv": [
        "insert"
      ],
      "flags": [
        "id",
        "pine",
        "pair",
        "tf"
      ]
    },
    "run": {
      "argv": [
        "run"
      ],
      "flags": [
        "id",
        "pine",
        "pair",
        "tf"
      ]
    },
    "editor": {
      "argv": [
        "editor"
      ],
      "flags": [
        "id",
        "mode",
        "text"
      ]
    },
    "look": {
      "argv": [
        "look"
      ],
      "flags": [
        "id",
        "out",
        "section"
      ]
    },
    "tab": {
      "argv": [
        "tab"
      ],
      "flags": [
        "id",
        "to"
      ]
    },
    "chart": {
      "argv": [
        "chart"
      ],
      "flags": [
        "id",
        "op",
        "dx",
        "dy",
        "dir",
        "size"
      ]
    },
    "asset": {
      "argv": [
        "asset"
      ],
      "flags": [
        "id",
        "symbol",
        "tf"
      ]
    },
    "tf": {
      "argv": [
        "tf"
      ],
      "flags": [
        "id",
        "tf",
        "symbol"
      ]
    },
    "widget": {
      "argv": [
        "widget"
      ],
      "flags": [
        "id",
        "action",
        "name"
      ]
    },
    "backtest": {
      "argv": [
        "backtest"
      ],
      "flags": [
        "id",
        "op",
        "speed",
        "date",
        "n"
      ]
    }
  }
}
