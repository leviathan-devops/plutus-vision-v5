#!/usr/bin/env bash
# pinebox - the Pine IDE as a self-contained, multi-instance agent computer.
#
# PINEBOX is computer-use v2 (the shell, the terminal, the scoped store, the drive verbs)
# with the Pine IDE as its default application layer. This file adds exactly one plane: the
# application layer (station, rail, server, page) bound to a port block derived from --id
# and to a serve-time rewrite of the config block the page already reads. It implements no
# display, input or capture logic of its own: every such action is the core's.
#
#   pinebox ports   --id N                         the derived ports + a claim verdict
#   pinebox up      --id N [--week W] [--pair P] [--tf T] [--pine F] [--adapter A]
#   pinebox down    --id N | --all
#   pinebox list                                    every instance
#   pinebox status  --id N [--project K]            the record, the last 5 refusals, measured memory
#   pinebox shot    --id N [--out F]                a CDP capture - never raises the window
#   pinebox load    --id N --pine F [--pair P] [--tf T]
#   pinebox drive   --id N --action VERB ...        the core's drive verbs, bound to this instance
#   pinebox terminal --id N --send TEXT | --read
#   pinebox state   --id N --get K | --put K V
#   pinebox view    --id N                          THE ONLY VERB PERMITTED TO RAISE A WINDOW
#
# Exit: 0 ok (one JSON object on stdout) | 1 REFUSED (a named token on stderr) | 2 usage

set -uo pipefail
PB_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PV_ROOT="$(cd "$PB_HOME/../.." && pwd)"
# THE CORE IS computer-use v2 (blueprint section 1: PINEBOX inherits it whole). It is located by
# CU_EXT (default: the OMP extension directory) - never by a symlink inside this repo, which
# would be a machine-specific path that dangles in any other checkout.
CU_EXT="${CU_EXT:-$HOME/.omp/agent/extensions/computer-use-v2}"
CORE="$CU_EXT/core"
[ -f "$CORE/lib.sh" ] || { printf 'REFUSED  CORE_ABSENT  —  the computer-use v2 core was not found at %s (set CU_EXT to its directory)\n' "$CORE" >&2; exit 1; }
PB_CORE_BIN="$(dirname "$CORE")/computer"
# bash `exec N>file` is INHERITED by every child (measured: no FD_CLOEXEC), and flock is released only
# when EVERY holder of the open file closes. The compositor, Xwayland and the browser the core
# spawns would each keep this instance's up/down lock (fds 6,7,8) alive for as long as they run -
# so a live instance held its own lock forever and `down` could never take it. Every call into the
# core therefore runs with the lock fds closed.
pb_computer() { "$PB_CORE_BIN" "$@" 6>&- 7>&- 8>&-; }
COMPUTER=pb_computer
. "$CORE/lib.sh"
. "$CORE/govern.sh"
. "$CORE/session.sh"     # SESSION SCOPE: the same registry the core uses (one id space; pinebox ids are the 0..9 range)
export PYTHONDONTWRITEBYTECODE=1   # never leave a __pycache__ in the tree (B13)
# THE INSTANCE ROOT IS PRIVATE BY CONSTRUCTION. The old default, /tmp/pinebox, was a predictable
# path in a world-writable directory, so every check on it (is it a symlink? who owns it?) was
# check-then-use and could be raced. The default is now $XDG_RUNTIME_DIR/pinebox: the parent is a
# 0700 directory owned by this user, so no other user can create, swap or symlink anything inside
# it. There is NO /tmp default; with neither PINEBOX_ROOT nor XDG_RUNTIME_DIR the tool refuses.
if [ -n "${PINEBOX_ROOT:-}" ]; then PB_ROOT="$PINEBOX_ROOT"
elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then PB_ROOT="$XDG_RUNTIME_DIR/pinebox"
else refuse PB_ROOT_UNAVAILABLE "neither PINEBOX_ROOT nor XDG_RUNTIME_DIR is set - set PINEBOX_ROOT to a directory only you can write (there is no /tmp default: it is a predictable path in a shared directory)"
fi
case "$PB_ROOT" in /*) ;; *) refuse PB_ROOT_UNAVAILABLE "the instance root must be an absolute path, got '$PB_ROOT'" ;; esac
[ -L "$PB_ROOT" ] && refuse SCOPE_VIOLATION "$PB_ROOT is a symlink - refusing to use it as the instance root"
mkdir -p -m 0700 -- "$PB_ROOT" || refuse PB_ROOT_UNAVAILABLE "could not create the instance root $PB_ROOT"
# ONE stat for owner, mode and type: three separate checks were three separate chances to be raced
read -r _pb_uid _pb_mode _pb_type < <(stat -c '%u %a %F' -- "$PB_ROOT" 2>/dev/null)
[ "${_pb_type:-}" = directory ] && [ "${_pb_uid:-x}" = "$(id -u)" ] \
  || refuse SCOPE_VIOLATION "$PB_ROOT is not a directory owned by uid $(id -u) (type '${_pb_type:-?}', owner '${_pb_uid:-?}')"
[ "$_pb_mode" = 700 ] || chmod 0700 -- "$PB_ROOT" || refuse SCOPE_VIOLATION "$PB_ROOT has mode $_pb_mode and could not be made 0700"
unset _pb_uid _pb_mode _pb_type

# every refusal is recorded per instance too: { token, verb, at }
eval "$(declare -f ledger_row | sed '1s/ledger_row/cu_ledger_row/')"
PB_VERB=""
ledger_row() {
  cu_ledger_row "$@"
  [[ "${CU_CTX_ID:-}" =~ ^(0|[1-9])$ ]] && [ -d "$PB_ROOT/i$CU_CTX_ID" ] && [ ! -L "$PB_ROOT/i$CU_CTX_ID" ] && \
    printf '{"token":"%s","verb":"%s","at":"%s"}\n' "$(jesc "$1")" "$PB_VERB" "$(date -Is)" >> "$PB_ROOT/i$CU_CTX_ID/refusals.jsonl"
}

. "$PB_HOME/ports.sh"
. "$PB_HOME/stages/services.sh"
. "$PB_HOME/stages/room.sh"
. "$PB_HOME/stages/page.sh"
. "$PB_HOME/stages/load.sh"
. "$PB_HOME/stages/verify.sh"
. "$PB_HOME/stages/v3.sh"
. "$PB_HOME/stages/v3_nav.sh"
. "$PB_HOME/stages/v3_backtest.sh"
need jq NO_JQ

pb_dir() { printf '%s/i%s' "$PB_ROOT" "$1"; }
# pb_dir is called inside $(...), where a refusal only ends the substitution and leaves an EMPTY path
# (which "$d/state.json" would turn into /state.json). Every WRITER therefore validates its id itself.
pb_need_id() { [[ "${1:-}" =~ ^(0|[1-9])$ ]] || refuse BAD_ID "pinebox instance id must be a canonical decimal 0..9, got '${1:-}'"; }

# pb_bind: the ONE place a pinebox verb gets its instance. --id must be one THIS session owns (and be a pinebox, not a plain computer);
# no --id means "my only pinebox". There is no default instance 0: every agent that omitted --id used to land on the same one.
pb_bind() {
  session_resolve
  local want out kind; want="$(flag id)"
  if [ -n "$want" ]; then
    pb_need_id "$want"
    out="$(reg check "$SESSION" "$want")" || exit $?
    kind="$(jq -r '.kind' <<<"$out")"
    [ "$kind" = pinebox ] || refuse WRONG_ECOSYSTEM "instance $want is a '$kind' instance, not a pinebox - drive it with \`computer\`, not \`pinebox\`"
    ID="$want"
  else
    out="$(reg sole "$SESSION" pinebox)" || exit $?
    ID="$(jq -r '.id' <<<"$out")"
  fi
  pb_need_id "$ID"; CU_CTX_ID="$ID"
}


# ── the instance record: JSON, updated under flock ───────────────────────────────────────
pb_rec() {
  local id="$1" filter="$2" d; pb_need_id "$id"; d="$(pb_dir "$id")"; [ -n "$d" ] || refuse BAD_ID "empty instance dir for '$id'"; mkdir -p -- "$d"
  ( flock -x 9
    [ -s "$d/state.json" ] || echo '{}' > "$d/state.json"
    jq "$filter" "$d/state.json" > "$d/state.json.tmp" && mv "$d/state.json.tmp" "$d/state.json"
  ) 9>"$d/.rec.lock" || refuse RECORD_WRITE_FAILED "could not update $d/state.json with: $filter"
}
pb_rec_get() { jq -r "($2) // empty" "$(pb_dir "$1")/state.json" 2>/dev/null; }

# re-raise a refusal the core printed, under its own token (so it stays structured)
pb_forward_refusal() {
  local f="$1" line tok
  line="$(grep -m1 '^REFUSED' "$f" 2>/dev/null || tail -1 "$f")"
  tok="$(printf '%s' "$line" | sed -nE 's/^REFUSED +([A-Za-z_:0-9]+) +—.*/\1/p')"
  refuse "${tok:-STAGE_FAILED}" "$(printf '%s' "$line" | sed -E 's/^REFUSED +[A-Za-z_:0-9]+ +— +//')"
}

# C3 around a verb that acts on an instance: identity-based, same predicate as the core
pb_c3() {
  local label="$1"; shift
  local before after out rc
  before="$(c3_snapshot)"; out="$("$@")"; rc=$?; after="$(c3_snapshot)"
  [ "$rc" -ne 0 ] && exit "$rc"
  c3_check "$before" "$after" "$label"
  printf '%s\n' "$out"
}

# ── teardown: by the RECORDED process group, never by a pattern ──────────────────────────
# Record a service we just backgrounded. A recorded pid is only a safe teardown target if it
# is its OWN process-group leader (setsid made it so), and it is stored with its start time so
# a pid reused after the service dies is never signalled (the C5 guarantee).
pb_svc_record() {
  local id="$1" name="$2" pid="$3" pg tok
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || refuse SERVICE_NOT_STARTED "$name: no valid pid ('$pid')"
  pg="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
  if [ "$pg" != "$pid" ]; then
    pb_rec "$id" ".pids.$name = $pid"
    refuse SERVICE_NOT_LEADER "$name pid $pid is not its own process-group leader (pgid '${pg:-gone}') - a group teardown would not reach it"
  fi
  tok="$(pid_token "$pid")"
  pb_rec "$id" ".pids.$name = $pid | .toks.$name = $(jq -nc --arg t "$tok" '$t')"
}

pb_kill_recorded() {
  local id="$1" k p tok killed=""
  for k in station rail server room; do
    p="$(pb_rec_get "$id" ".pids.$k")"; tok="$(pb_rec_get "$id" ".toks.$k")"
    if [ -n "$tok" ]; then
      tok_group_ours "$tok" && { kill_tok "$tok"; killed="$killed $p"; }
    elif [ -n "$p" ]; then
      # a pid with NO start-time token cannot be told apart from an unrelated process that reused the
      # number, so it is never signalled (the C5 guarantee). pb_svc_record always writes both; a record
      # lacking the token is damaged or hand-made, and its owner is told instead of being killed.
      printf 'pinebox: instance %s service %s has pid %s but NO identity token - not signalling it (stop it by hand if it is yours)\n' "$id" "$k" "$p" >&2
    fi
  done
  printf '%s' "${killed# }"
}

pb_teardown() {
  local id="$1" killed d; d="$(pb_dir "$id")"
  [ -L "$d" ] && refuse SCOPE_VIOLATION "$d is a symlink - refusing to tear down through it"
  # `down` must not run mid-`up`: it would kill the groups and delete state.json under a
  # half-started instance. `up` holds this same lock; its own cleanup passes PB_LOCK_HELD=1.
  if [ "${PB_LOCK_HELD:-0}" != 1 ]; then
    exec 8>"$PB_ROOT/.up-$id.lock"
    flock -w 120 8 || refuse INSTANCE_BUSY "an 'up' for instance $id still holds the lock after 120s - not tearing down under it"
  fi
  killed="$(pb_kill_recorded "$id")"
  "$COMPUTER" shell down --id "$id" >/dev/null 2>&1 || true   # compositor + the browser the core spawned
  rm -rf -- "$d/chrome" "$d/state.json"
  exec 8>&- 2>/dev/null || true
  printf '%s' "$killed"
}

pb_instance_live() {   # the core still has a live compositor for this id
  "$COMPUTER" shell list 2>/dev/null | jq -e --argjson i "$1" 'any(.instances[]; .id==$i)' >/dev/null 2>&1
}

# ── up: the five stages, in order, each verified, each refusing by name ─────────────────
PB_UP_ID=""; PB_UP_OK=0
PB_CLAIM_NEW=""
pb_up_cleanup() {
  [ -n "$PB_UP_ID" ] && [ "$PB_UP_OK" -eq 0 ] && { pb_teardown "$PB_UP_ID" >/dev/null; echo "  (the partly started instance $PB_UP_ID was torn down; logs kept in $(pb_dir "$PB_UP_ID"))" >&2; }
  # a claim THIS call made must not outlive a failed start
  [ -n "$PB_CLAIM_NEW" ] && [ "$PB_UP_OK" -eq 0 ] && bun "$REGISTRY_CLI" "$ROOT" release "$SESSION" "$PB_CLAIM_NEW" >/dev/null 2>&1
  return 0
}

pb_up() {
  # the registry ALLOCATES this session's pinebox id (0..9), or re-issues the one it already owns; an id another session owns is refused by name
  session_resolve
  local want claim; want="$(flag id)"; [ -z "$want" ] || pb_need_id "$want"
  claim="$(reg claim "$SESSION" pinebox "$want")" || exit $?
  [ "$(jq -r '.kind' <<<"$claim")" = pinebox ] || refuse WRONG_ECOSYSTEM "instance $(jq -r '.id' <<<"$claim") is a computer instance of this session - bring a pinebox up on another id"
  require_id "$(jq -r '.id' <<<"$claim")"; pb_need_id "$ID"; local id="$ID"
  if [ "$(jq -r '.reused' <<<"$claim")" = false ]; then PB_CLAIM_NEW="$id"; trap pb_up_cleanup EXIT; fi   # a claim THIS call made is released if the start fails
  pb_ports_json "$id" >/dev/null || exit $?
  local week pair tf pine adapter d
  week="$(flag week 2026-07-06)"; pair="$(flag pair DXY)"; tf="$(flag tf 1H)"; pine="$(flag pine)"; adapter="$(flag adapter)"
  d="$(pb_dir "$id")"

  # Serialize stale-record reaping and live checks under the SAME per-id lock;
  # otherwise two ups can both pass the live check before either writes state.
  [ -L "$d" ] && refuse SCOPE_VIOLATION "$d is a symlink - refusing to start an instance through it"
  exec 7>"$PB_ROOT/.up-$id.lock"; flock -n 7 || refuse INSTANCE_LIVE "an 'up' for pinebox instance $id is already in progress"
  PB_LOCK_HELD=1     # this process owns the per-id lock: its own teardowns must not re-take it
  if [ -s "$d/state.json" ]; then
    if pb_instance_live "$id"; then refuse INSTANCE_LIVE "pinebox instance $id is already running - run: pinebox down --id $id"; fi
    echo "  (reaping a stale record for instance $id)" >&2; pb_teardown "$id" >/dev/null
    # the teardown runs \`computer shell down\`, which RELEASES the registry claim this start just made - the next stage would then re-claim
    # the id as a plain computer, and \`pinebox status\` would say this session has no pinebox. Re-establish the claim the reap dropped.
    reg claim "$SESSION" pinebox "$id" >/dev/null || exit $?
  fi
  pb_preflight "$week" "$id"
  pb_room_preflight      # the room substrate is checked BEFORE anything is started: a refusal here leaves nothing behind
  pb_claim "$id"                                    # PORT_TAKEN:<port> - both before anything starts
  mkdir -p "$d"
  : > "$d/refusals.jsonl"
  jq -n --argjson id "$id" --argjson ports "$(pb_ports_json "$id")" --arg week "$week" --arg pair "$pair" --arg tf "$tf" \
     '{id:$id, ports:$ports, week:$week, pair:$pair, tf:$tf, pids:{}}' > "$d/state.json"
  PB_UP_ID="$id"; trap pb_up_cleanup EXIT

  local before; before="$(c3_snapshot)"
  echo "pinebox up  instance $id" >&2

  # STAGE 1 · THE SHELL - the computer-use core. A window on the operator's screen that
  # STAYS IN THE BACKGROUND.
  local out slot hw
  out="$("$COMPUTER" shell up --id "$id" ${adapter:+--adapter "$adapter"} 2>"$d/shell.err")" || pb_forward_refusal "$d/shell.err"
  slot="$(jq -r .x_slot <<<"$out")"
  hw="$(jq -r '.instance.host_win // empty' <<<"$out")"
  # every value enters the record as a jq-ENCODED literal: a quote, backslash or newline in
  # core output must not break (or inject into) the filter
  pb_rec "$id" ".slot = $(jq -nc --arg v "$slot" '$v') | .adapter = $(jq -c .adapter <<<"$out") | .host_win = $(jq -nc --arg v "$hw" '$v') | .up_at = $(jq -nc --arg v "$(date -Is)" '$v')"
  printf '  shell     :%s (%s)%s\n' "$slot" "$(jq -r .adapter <<<"$out")" "${hw:+ host window $hw}" >&2

  stage_services "$id" "$d" "$week" || exit $?
  stage_room "$id" "$d" "$week" || exit $?
  stage_page "$id" "$d" || exit $?
  stage_frame "$id" "$d" || exit $?
  stage_week_set "$id" "$(pb_iso_week "$week")" >/dev/null 2>&1 || true
  if [ -n "$pine" ]; then stage_load "$id" "$d" "$pine" "$pair" "$tf" || exit $?; fi

  # P7: the whole `up` - not just its first stage - must have left the operator's focus alone
  local after; after="$(c3_snapshot)"
  c3_check "$before" "$after" "pinebox up" "$hw"

  PB_UP_OK=1
  echo "  READY     instance $id  slot :$slot" >&2
  jq -c '{ok:true, id, slot, adapter, ports, frame, load}' "$d/state.json"
}

pb_down() {
  if [ "$(flag all)" = 1 ]; then
    # "all" is all of THIS SESSION's pineboxes. It used to tear down every instance directory on the host, other agents' included.
    local n=0 mine i
    session_resolve
    mine="$(reg list "$SESSION")" || exit $?
    for i in $(jq -r '.instances[]|select(.kind=="pinebox")|.id' <<<"$mine"); do
      pb_teardown "$i" >/dev/null; n=$((n+1))
    done
    printf '{"ok":true,"down":"all","instances":%s}\n' "$n"
  else
    pb_bind
    [ -s "$(pb_dir "$ID")/state.json" ] || refuse NOT_UP "pinebox instance $ID is not up"
    local killed; killed="$(pb_teardown "$ID")"
    printf '{"ok":true,"down":%s,"killed":"%s"}\n' "$ID" "$killed"
  fi
}

# ── measured memory ──────────────────────────────────────────────────────────────────────
# PSS summed over a process group, from /proc/<pid>/smaps_rollup. A process that hides its
# rollup (non-dumpable: measured, the pv-server python gets "Permission denied" for the same
# uid) is reported as UNREADABLE with its pid - never folded into the sum as 0, which would
# read as "uses no memory". Output: "<kB> <unreadable-pid-list-or-->".
pb_pss_group() {
  local pid sum=0 v bad=""
  for pid in $(pgrep -g "$1" 2>/dev/null); do
    if v="$(awk '/^Pss:/ {print $2}' "/proc/$pid/smaps_rollup" 2>/dev/null)" && [ -n "$v" ]; then sum=$((sum + v))
    else bad="${bad:+$bad,}$pid"; fi
  done
  printf '%s %s' "$sum" "${bad:--}"
}

pb_status() {
  pb_bind; local id="$ID" d; d="$(pb_dir "$id")"
  [ -s "$d/state.json" ] || refuse NOT_UP "pinebox instance $id is not up"
  local k_ comp_ r kb bad name total=0 unread="" parts="" t
  # name:leader-pid, one per recorded process group (the browser's pids are core tokens: pid:start)
  local groups="station:$(pb_rec_get "$id" .pids.station) rail:$(pb_rec_get "$id" .pids.rail) server:$(pb_rec_get "$id" .pids.server) room:$(pb_rec_get "$id" .pids.room) compositor:$(rec_get "$id" comp_pid 2>/dev/null || true)"
  for t in $(rec_get "$id" app_pids 2>/dev/null || true); do groups="$groups browser:$(tok_pid "$t")"; done
  local -A mb=() ; local entry
  for entry in $groups; do
    name="${entry%%:*}"; r="$(pb_pss_group "${entry#*:}")"; kb="${r%% *}"; bad="${r#* }"
    mb[$name]=$(( ${mb[$name]:-0} + kb/1024 )); total=$((total + kb/1024))
    [ "$bad" != "-" ] && unread="${unread:+$unread; }$name pid(s) $bad"
  done
  local k; k="$(flag project 7)"
  jq --argjson st "${mb[station]:-0}" --argjson ra "${mb[rail]:-0}" --argjson sv "${mb[server]:-0}" \
     --argjson co "${mb[compositor]:-0}" --argjson ch "${mb[browser]:-0}" --argjson one "$total" --argjson k "$k" \
     --arg unread "$unread" \
     --slurpfile tok <(tail -5 "$d/refusals.jsonl" 2>/dev/null | jq -c . 2>/dev/null || true) \
     '. + {last_refusals: $tok, memory_mb: {station:$st, rail:$ra, server:$sv, compositor:$co, browser:$ch, instance:$one,
        unreadable: (if $unread == "" then null else $unread end),
        lower_bound: ($unread != ""),
        projected_for: $k, projected_total: ($one * $k),
        note: "MEASURED PSS summed over this instance'"'"'s recorded process groups; any process whose smaps_rollup is hidden is named in `unreadable` and NOT counted (so `instance` is then a lower bound); the projection assumes every instance costs the same"}}' \
     "$d/state.json" | jq -c '{ok:true} + .'
}

pb_list() {
  local d out="" id slot alive row mine
  session_resolve; mine="$(reg list "$SESSION")" || exit $?
  for id in $(jq -r '.instances[]|select(.kind=="pinebox")|.id' <<<"$mine"); do
    d="$(pb_dir "$id")"
    [ -s "$d/state.json" ] || continue
    alive=false; pb_instance_live "$id" && alive=true
    row="$(jq -c --argjson a "$alive" '{id, slot, adapter, ports, window:.chrome.window, colours:.frame.colours, pids, alive:$a}' "$d/state.json")"
    out="${out:+$out,}$row"
  done
  printf '{"ok":true,"instances":[%s]}\n' "$out"
}

pb_shot() {
  pb_bind; local id="$ID" d out; d="$(pb_dir "$id")"
  [ -s "$d/state.json" ] || refuse NOT_UP "pinebox instance $id is not up"
  out="$(flag out "$d/frame.png")"
  pb_c3 "pinebox shot" "$COMPUTER" screenshot --id "$id" --out "$out"
}

pb_load() {
  pb_bind; local id="$ID" d; d="$(pb_dir "$id")"
  [ -s "$d/state.json" ] || refuse NOT_UP "pinebox instance $id is not up"
  [ -n "$(flag pine)" ] || refuse BAD_ARGS "load needs --pine FILE"
  local before after; before="$(c3_snapshot)"
  stage_load "$id" "$d" "$(flag pine)" "$(flag pair "$(pb_rec_get "$id" .pair)")" "$(flag tf "$(pb_rec_get "$id" .tf)")"
  after="$(c3_snapshot)"; c3_check "$before" "$after" "pinebox load"
  jq -c '{ok:true, frame, load}' "$d/state.json"
}

# ── the core's verbs, bound to this instance ──────────────────────────────────────────────
pb_drive() {   # drive --id N --action VERB [core flags...]
  local id action rest=() a skip=0
  pb_bind; id="$ID"; action="$(flag action)"; [ -n "$action" ] || refuse BAD_ARGS "drive needs --action VERB"
  local args=("${PB_ARGS[@]}") i=0 nid=0 nact=0
  while [ $i -lt ${#args[@]} ]; do
    case "${args[$i]}" in
      --id)     nid=$((nid+1));   i=$((i+2)) ;;
      --action) nact=$((nact+1)); i=$((i+2)) ;;
      # `--id=2` was NOT recognised as the id flag, so it rode through into the core call as a second,
      # attacker-chosen --id; reject the glued form outright
      --id=*|--action=*) refuse BAD_ARGS "drive takes '--id N' and '--action VERB' as separate arguments, got '${args[$i]}'" ;;
      *) rest+=("${args[$i]}"); i=$((i+1)) ;;
    esac
  done
  [ "$nid" -le 1 ] && [ "$nact" -le 1 ] || refuse BAD_ARGS "drive got a repeated --id or --action (id x$nid, action x$nact)"
  [ -s "$(pb_dir "$id")/state.json" ] || refuse NOT_UP "pinebox instance $id is not up"
  # an ALLOWLIST: drive forwards INPUT/CAPTURE verbs only. `view` raises a window, and
  # shell_*/terminal_*/state_*/app_* change the instance itself - none may ride in here.
  case "$action" in
    focus|click|type|key|screenshot) ;;
    *) refuse BAD_ARGS "drive --action '$action' is not an input/capture verb (allowed: focus click type key screenshot)" ;;
  esac
  # The verb was allowlisted but its FLAGS were forwarded verbatim: `drive --action screenshot --out /any/path` wrote
  # wherever the caller named, and an abbreviated `--i 5` could override the instance. Each action takes a fixed set of
  # flags, every flag takes one value, and --out must resolve inside THIS instance's directory.
  local -a allow; local j key val real
  case "$action" in
    focus)      allow=(--win --title) ;;
    click)      allow=(--x --y --button --win --cdp) ;;
    type)       allow=(--text --win --cdp) ;;
    key)        allow=(--key --win --cdp) ;;
    screenshot) allow=(--out --win --cdp) ;;
  esac
  j=0
  while [ "$j" -lt "${#rest[@]}" ]; do
    key="${rest[$j]}"; val="${rest[$((j+1))]:-}"
    [[ " ${allow[*]} " == *" $key "* ]] || refuse BAD_ARGS "drive $action takes only ${allow[*]}, got '$key'"
    [ "$((j+1))" -lt "${#rest[@]}" ] || refuse BAD_ARGS "drive $action: flag '$key' has no value"
    if [ "$key" = --out ]; then
      real="$(realpath -m -- "$val")"
      case "$real" in "$(pb_dir "$ID")"/*.png) ;; *) refuse BAD_ARGS "drive screenshot --out must be a .png inside this instance's directory $(pb_dir "$ID")/, got '$val'" ;; esac
    fi
    j=$((j+2))
  done
  pb_c3 "drive $action" "$COMPUTER" "$action" --id "$ID" "${rest[@]}"
}

pb_terminal() {
  pb_bind
  [ -s "$(pb_dir "$ID")/state.json" ] || refuse NOT_UP "pinebox instance $ID is not up"
  if [ -n "$(flag send)" ]; then "$COMPUTER" terminal send --id "$ID" --text "$(flag send)"
  elif [ "$(flag read)" = 1 ]; then "$COMPUTER" terminal read --id "$ID" --lines "$(flag lines 50)"
  else refuse BAD_ARGS "terminal needs --send TEXT or --read"; fi
}

pb_state() {
  pb_bind
  [ -s "$(pb_dir "$ID")/state.json" ] || refuse NOT_UP "pinebox instance $ID is not up"
  if [ -n "$(flag get)" ]; then "$COMPUTER" state get --id "$ID" --key "$(flag get)"
  elif [ -n "$(flag put)" ]; then "$COMPUTER" state put --id "$ID" --key "$(flag put)" --value "$(flag value)"
  else refuse BAD_ARGS "state needs --get K or --put K V"; fi
}

pb_week() {
  pb_bind; [ -s "$(pb_dir "$ID")/state.json" ] || refuse NOT_UP "pinebox instance $ID is not up"
  [ -n "$(flag set)" ] || refuse BAD_ARGS "week needs --set YYYY-Www"
  stage_week_set "$ID" "$(flag set)"
  printf '{"ok":true,"id":%s,"week":"%s"}\n' "$ID" "$(flag set)"
}

pb_verify() {
  pb_bind; local d; d="$(pb_dir "$ID")"
  [ -s "$d/state.json" ] || refuse NOT_UP "pinebox instance $ID is not up"
  local w; w="$(flag week "$(pb_rec_get "$ID" .week)")"; [ -n "$w" ] || w="$(pb_rec_get "$ID" .week)"
  stage_verify "$ID" "$d" "$w"
}

pb_view() {
  pb_bind
  [ -s "$(pb_dir "$ID")/state.json" ] || refuse NOT_UP "pinebox instance $ID is not up"
  # --confirm is the operator's "I asked to see it"; the core refuses the raise without it
  "$COMPUTER" view --id "$ID" ${FLAG[confirm]:+--confirm}
}

pb_ports() {
  if [ -n "$(flag id)" ]; then require_id "$(flag id)"; pb_need_id "$ID"; else pb_bind; fi   # derived numbers for a named id; no id means this session's own
  local json; json="$(pb_ports_json "$ID")" || exit $?
  local name port holder status="" rows=""
  for name in station rail server cdp ws vnc room; do
    port="$(pb_port "$ID" "$name")"; holder="$(pb_port_holder "$port")"
    status="free"; [ -n "$holder" ] && status="held by pid ${holder%% *}"
    rows="${rows:+$rows,}\"$name\":\"$status\""
  done
  local claimed=true; case "$rows" in *"held by"*) claimed=false ;; esac
  printf '{"ok":true,"id":%s,"ports":%s,"state":{%s},"claimable":%s}\n' "$ID" "$json" "$rows" "$claimed"
}

usage() { sed -n '2,/^# Exit:/p' "$0" | sed 's/^# \{0,1\}//'; }

PB_VERB="${1:-help}"; shift || true
# `state --put K V` (blueprint 7B): the value is the word after the key. Rewritten to the flag
# form the parser reads, so a value is never mistaken for a stray argument.
_argv=(); _i=0; _a=("$@")
while [ $_i -lt ${#_a[@]} ]; do
  if [ "${_a[$_i]}" = "--put" ] && [ $((_i+2)) -lt ${#_a[@]} ] && [[ "${_a[$((_i+2))]}" != --* ]]; then
    _argv+=(--put "${_a[$((_i+1))]}" --value "${_a[$((_i+2))]}"); _i=$((_i+3))
  else _argv+=("${_a[$_i]}"); _i=$((_i+1)); fi
done
set -- "${_argv[@]}"
PB_ARGS=("$@")
case "$PB_VERB" in help|-h|--help) usage; exit 2 ;; esac
parse_flags "$@"
# a bare positional after --put K is the value; booleans the parser needs to know
case "$PB_VERB" in
  ports)    pb_ports ;;
  up)       pb_up ;;
  down)     pb_down ;;
  list)     pb_list ;;
  status)   pb_status ;;
  shot)     pb_shot ;;
  load)     pb_load ;;
  drive)    pb_drive "$@" ;;
  terminal) pb_terminal ;;
  state)    pb_state ;;
  view)     pb_view ;;
  week)     pb_week ;;
  verify)   pb_verify ;;
  insert)   pb_v3_insert "$@" ;;
  run)      pb_v3_run "$@" ;;
  editor)   pb_v3_editor "$@" ;;
  look)     pb_v3_look "$@" ;;
  tab)      pb_nav_tab "$@" ;;
  chart)    pb_nav_chart "$@" ;;
  asset)    pb_nav_asset "$@" ;;
  tf)       pb_nav_tf "$@" ;;
  widget)   pb_nav_widget "$@" ;;
  backtest) pb_bt "$@" ;;
  *) refuse BAD_VERB "unknown verb '$PB_VERB' - run: pinebox help" ;;
esac
